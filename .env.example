# ---- Server ----
PORT=3200
NODE_ENV=production
PUBLIC_URL=https://euphoriax.net/dashboard   # full public URL of the dashboard
BASE_PATH=/dashboard                         # mount path behind euphoriax.net ("" when on its own subdomain)
DATA_DIR=./data

# ---- Login (only you two) ----
# npm run hash-password -- tom 'a-long-password'   -> paste both lines joined with a comma
DASHBOARD_USERS=
SESSION_SECRET=                              # long random string: openssl rand -hex 32

# ---- Keys for machines/bots talking to the dashboard ----
INGEST_KEY=                                  # bots, Discord tools: heartbeats + messages + sales
MACHINE_KEY=                                 # the UEFN build PC (machine/worker.mjs)

# ---- Notifications (private Discord channel webhook) ----
NOTIFY_DISCORD_WEBHOOK=

# ---- Daily AI analysis ----
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
DAILY_ANALYSIS_HOUR=7

# ---- Incoming ----
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REFRESH_TOKEN=
INSTAGRAM_TOKEN=
INSTAGRAM_USER_ID=
TWITTER_BEARER_TOKEN=
TWITTER_USER_ID=
PATREON_ACCESS_TOKEN=
PATREON_WEBHOOK_SECRET=
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
UEFN_TRENDS_URL=                             # e.g. http://127.0.0.1:3100
UEFN_TRENDS_ADMIN_KEY=
COLLECT_EVERY_MIN=60

# ---- Outgoing ----
PUBLISHER=manual                             # manual | ayrshare | webhook
AYRSHARE_API_KEY=
PUBLISH_WEBHOOK_URL=                         # n8n / Make / Zapier webhook
